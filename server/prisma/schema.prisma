generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  password      String
  role          String     @default("USER") // USER, MANAGER, or SUPER_ADMIN
  managerId     String?    // For USER role - assigned manager
  manager       User?      @relation("UserManager", fields: [managerId], references: [id])
  managedUsers  User[]     @relation("UserManager") // For MANAGER role - users under them
  documents     Document[] @relation("UserDocuments")
  reviewedDocs  Document[] @relation("ManagerReviews") // Documents reviewed by this manager
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Document {
  id               String         @id @default(uuid())
  title            String
  documentType     String         // WRITTEN or UPLOADED
  htmlContent      String?
  originalFilename String?
  pdfPath          String?
  pdfData          String?        @db.Text // Store PDF as base64 for serverless
  completedPdfPath String?
  pageCount        Int            @default(1)
  documentHash     String?
  status           String         @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, DENIED, PENDING, IN_PROGRESS, COMPLETED, VOIDED
  approvalStatus   String?        // PENDING, APPROVED, DENIED
  managerFeedback  String?        // Feedback from manager if denied
  reviewedById     String?        // Manager who reviewed
  reviewedBy       User?          @relation("ManagerReviews", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?      // When it was reviewed
  emailSubject     String?        // Custom email subject for recipients
  emailMessage     String?        @db.Text // Custom email message for recipients
  expiresAt        DateTime?
  completedAt      DateTime?
  userId           String
  user             User           @relation("UserDocuments", fields: [userId], references: [id])
  recipients       Recipient[]
  fields           SignatureField[]
  auditLogs        AuditLog[]
  deletedAt        DateTime?      // Soft delete timestamp
  deletedBy        String?        // Email of user who deleted it
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Recipient {
  id             String          @id @default(uuid())
  documentId     String
  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name           String
  email          String
  role           String          @default("SIGNER") // SIGNER, VIEWER, APPROVER, CC
  signingOrder   Int             @default(1)
  accessToken    String          @unique @default(uuid())
  tokenExpiresAt DateTime?
  status         String          @default("PENDING") // PENDING, SENT, VIEWED, SIGNED, DECLINED
  viewedAt       DateTime?
  signedAt       DateTime?
  ipAddress      String?
  userAgent      String?
  fields         SignatureField[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model SignatureField {
  id            String    @id @default(uuid())
  documentId    String
  recipientId   String
  fieldType     String    // SIGNATURE, INITIALS, DATE, TEXT, CHECKBOX
  pageNumber    Int
  xPercent      Float
  yPercent      Float
  widthPercent  Float
  heightPercent Float
  isRequired    Boolean   @default(true)
  value         String?
  completedAt   DateTime?
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipient     Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action     String
  actorEmail String?
  actorName  String?
  ipAddress  String?
  userAgent  String?
  details    String?
  createdAt  DateTime @default(now())
}

model Template {
  id          String   @id @default(uuid())
  name        String
  htmlContent String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
